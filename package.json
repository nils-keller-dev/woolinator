    "typescript": "~6.0.3"
  },
  "scripts": {
    "build:pdf": "npm run build --workspace=@woolinator/pdf-viewer",
    "build:pdf:watch": "npm run build --workspace=@woolinator/pdf-viewer -- --watch",
