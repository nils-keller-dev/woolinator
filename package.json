    "preandroid": "npm run build:pdf",
    "start": "npm run build:pdf:watch & expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "private": true,
  "workspaces": [
    "apps/*"
